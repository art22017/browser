<Window x:Class="Argon.Host.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Argon.Host" Title="Argon" Width="1280" Height="820" MinWidth="760" MinHeight="520" Background="#202125" Foreground="#ECEEF5" FontFamily="Segoe UI Variable, Segoe UI" WindowStyle="None" ResizeMode="CanResize">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="40" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="#16FFFFFF" BorderThickness="0,0,0,1">
      <Grid><TextBlock Text="Argon" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="−" Width="42" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize window"/>
          <Button Content="□" Width="42" Click="MaximizeClick" ToolTip="Maximize / restore" AutomationProperties.Name="Maximize or restore window"/>
          <Button Content="×" Width="42" Click="CloseClick" ToolTip="Close" AutomationProperties.Name="Close window"/>
        </StackPanel>
      </Grid>
    </Border>
    <local:BrowserSurface x:Name="Surface" Grid.Row="1"/>
    <Border Grid.Row="2" BorderBrush="#16FFFFFF" BorderThickness="0,1,0,0" Background="#25262B">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="WorkspaceButtons" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"/></ScrollViewer>
        <Button Grid.Column="1" Content="+ Workspace" Margin="8,4" Click="CreateWorkspaceClick" ToolTip="Create a workspace with its own profile"/>
      </Grid>
    </Border>
    <Border x:Name="Status" Grid.Row="1" Background="#202125" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="24">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="16" TextAlignment="Center"/>
        <Button x:Name="RetryButton" Content="Try again" Click="RetryClick" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
